#!/usr/bin/env bash
set -Eeuo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Jalankan sebagai root" >&2; exit 1; }
[ -s /etc/tunnel/node.json ] || /usr/local/tunnel/node/node-register
cat > /etc/systemd/system/tunnel-heartbeat.service <<'UNIT'
[Unit]
Description=Tunnel Go Node Heartbeat
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/tunnel/node/node-heartbeat
UNIT
cat > /etc/systemd/system/tunnel-heartbeat.timer <<'UNIT'
[Unit]
Description=Run Tunnel Go Node Heartbeat every minute
[Timer]
OnBootSec=45sec
OnUnitActiveSec=60sec
AccuracySec=15sec
Unit=tunnel-heartbeat.service
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now tunnel-heartbeat.timer >/dev/null 2>&1 || true
echo "Node agent heartbeat aktif"
