#!/usr/bin/env bash
set -Eeuo pipefail
. /usr/local/tunnel/lib/common
require_root
cat > /etc/sysctl.d/99-tunnel-go-v5.conf <<'SYS'
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
net.ipv4.tcp_keepalive_time=30
net.ipv4.tcp_keepalive_intvl=10
net.ipv4.tcp_keepalive_probes=3
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_tw_reuse=1
net.ipv4.tcp_mtu_probing=1
net.core.somaxconn=65535
net.core.netdev_max_backlog=250000
net.ipv4.ip_local_port_range=1024 65535
net.ipv4.udp_rmem_min=8192
net.ipv4.udp_wmem_min=8192
SYS
sysctl --system >/dev/null 2>&1 || true
if command -v iptables >/dev/null 2>&1; then
  iptables -t nat -C POSTROUTING -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -j MASQUERADE
  iptables -C FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -A FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT
  iptables -C FORWARD -j ACCEPT 2>/dev/null || iptables -A FORWARD -j ACCEPT
fi
print_ok 'Connection optimizer diterapkan'
