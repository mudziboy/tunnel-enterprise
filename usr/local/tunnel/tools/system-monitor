#!/usr/bin/env bash
set -Eeuo pipefail

echo "System Monitor"
echo "=============="
echo "Hostname : $(hostname)"
echo "Uptime   : $(uptime -p 2>/dev/null || true)"
echo "Kernel   : $(uname -r)"
echo ""
free -h 2>/dev/null || true
echo ""
df -h / 2>/dev/null || true
echo ""
ss -s 2>/dev/null || true
