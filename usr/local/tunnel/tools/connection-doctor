#!/usr/bin/env bash
set -Eeuo pipefail
. /usr/local/tunnel/lib/config 2>/dev/null || true
. /usr/local/tunnel/lib/common
load_tunnel_config 2>/dev/null || true
host="${1:-127.0.0.1}"
check_tcp(){ local name="$1" port="$2"; if timeout 3 bash -c "</dev/tcp/$host/$port" 2>/dev/null; then printf '%-18s ON  tcp/%s\n' "$name" "$port"; else printf '%-18s OFF tcp/%s\n' "$name" "$port"; fi; }
check_udp(){ local name="$1" port="$2"; if ss -lnu 2>/dev/null | grep -qE ":$port([[:space:]]|$)"; then printf '%-18s ON  udp/%s\n' "$name" "$port"; else printf '%-18s OFF udp/%s\n' "$name" "$port"; fi; }
echo "Tunnel Go Connection Doctor"
echo "Target: $host"
echo "============================"
check_tcp SSH "${SSH_PORT:-22}"
check_tcp DROPBEAR "$(echo "${DROPBEAR_PORTS:-109,143}" | cut -d, -f1)"
check_tcp HTTP "${HTTP_PORT:-80}"
check_tcp HTTPS "${HTTPS_PORT:-443}"
check_tcp WS-PROXY 1010
check_tcp VLESS-WS "${XRAY_VLESS_WS_PORT:-10001}"
check_tcp VMESS-WS "${XRAY_VMESS_WS_PORT:-10002}"
check_tcp TROJAN-WS "${XRAY_TROJAN_WS_PORT:-10003}"
check_tcp SS-WS "${XRAY_SHADOWSOCKS_WS_PORT:-10004}"
check_udp ZIVPN "${ZIVPN_PORT:-5667}"
check_udp HYSTERIA2 "${HYSTERIA2_PORT:-8443}"
check_udp TUIC "${TUIC_PORT:-4433}"
check_udp WIREGUARD "${WIREGUARD_PORT:-51820}"
echo
echo "Saran payload SSH WS stabil:"
echo "GET /sshws HTTP/1.1[crlf]Host: [host][crlf]Upgrade: websocket[crlf]Connection: Upgrade[crlf][crlf]"
echo "Jika client butuh HTTP/1.1 200, set WS_RESPONSE_MODE=200 di tunnel-ws-proxy.service lalu restart service."
