#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/tunnel/lib/account

require_root
account_init

protocol="$(account_select_protocol)" || { print_err "Protocol tidak valid"; exit 1; }
read -rp "Username: " username
require_valid_username "$username"

if ! db_account_exists "$username" "$protocol"; then
  print_err "Akun tidak ditemukan: $username/$protocol"
  exit 1
fi

if ! confirm "Hapus akun $username/$protocol?"; then
  exit 0
fi

if account_dispatcher_exists delete "$protocol"; then
  account_dispatch delete "$protocol" "$username"
else
  print_warn "Dispatcher protocol belum aktif. Data hanya dihapus dari database."
fi

account_id="$(db_account_id "$username" "$protocol")"
db_log_event "$account_id" "$username" "$protocol" "delete" ""
db_delete_account "$username" "$protocol"
audit_log "local" "delete-account" "$username/$protocol" "-"

print_ok "Akun dihapus"
