#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/tunnel/lib/common
. /usr/local/tunnel/lib/config
. /usr/local/tunnel/lib/dependencies

require_root
load_tunnel_config
install_packages openvpn easy-rsa

mkdir -p /etc/openvpn/server /etc/tunnel/runtime/openvpn /etc/tunnel/users/openvpn

cat > /etc/openvpn/server/tunnel-tcp.conf <<EOF
port ${OPENVPN_TCP_PORT:-1194}
proto tcp
dev tun
user nobody
group nogroup
persist-key
persist-tun
topology subnet
server 10.8.0.0 255.255.255.0
ifconfig-pool-persist /etc/openvpn/server/ipp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 1.1.1.1"
push "dhcp-option DNS 8.8.8.8"
keepalive 10 120
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-CBC
auth SHA256
verb 3
explicit-exit-notify 0
status /var/log/openvpn-status.log
client-config-dir /etc/openvpn/server/ccd
EOF

cat > /etc/openvpn/server/tunnel-udp.conf <<EOF
port ${OPENVPN_UDP_PORT:-2200}
proto udp
dev tun
user nobody
group nogroup
persist-key
persist-tun
topology subnet
server 10.9.0.0 255.255.255.0
ifconfig-pool-persist /etc/openvpn/server/ipp-udp.txt
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 1.1.1.1"
push "dhcp-option DNS 8.8.8.8"
keepalive 10 120
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-CBC
auth SHA256
verb 3
explicit-exit-notify 1
status /var/log/openvpn-status-udp.log
client-config-dir /etc/openvpn/server/ccd
EOF

mkdir -p /etc/openvpn/server/ccd
print_warn "OpenVPN config dasar dibuat. PKI/certificate akan diaktifkan pada tahap hardening OpenVPN."
systemctl enable openvpn-server@tunnel-tcp >/dev/null 2>&1 || true
systemctl enable openvpn-server@tunnel-udp >/dev/null 2>&1 || true

print_ok "OpenVPN manager dasar siap"
