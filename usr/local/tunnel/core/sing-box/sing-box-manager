#!/usr/bin/env bash
set -Eeuo pipefail

while true; do
  clear
  echo "Sing-box Manager"
  echo "1. Install Sing-box"
  echo "2. Render Config"
  echo "3. Restart Sing-box"
  echo "4. Status Sing-box"
  echo "5. Back"
  read -rp "Pilih menu: " opt
  case "$opt" in
    1) /usr/local/tunnel/core/sing-box/install-sing-box ;;
    2) /usr/local/tunnel/core/sing-box/render-sing-box-config ;;
    3) systemctl restart sing-box ;;
    4) systemctl status sing-box --no-pager ;;
    5) exit 0 ;;
    *) echo "Pilihan tidak valid" ;;
  esac
  read -rp "Enter untuk kembali..." _
done
