#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/tunnel/lib/common
. /usr/local/tunnel/lib/dependencies
. /usr/local/tunnel/lib/database

require_root
db_init
install_packages curl tar gzip

arch="$(uname -m)"
case "$arch" in
  x86_64) asset_arch="amd64" ;;
  aarch64|arm64) asset_arch="arm64" ;;
  armv7l|armv7) asset_arch="armv7" ;;
  *) print_err "Arsitektur tidak didukung: $arch"; exit 1 ;;
esac

version="${SING_BOX_VERSION:-}"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

if [ -z "$version" ]; then
  version="$(curl -fsSL https://api.github.com/repos/SagerNet/sing-box/releases/latest | jq -r '.tag_name' | sed 's/^v//')"
fi

url="https://github.com/SagerNet/sing-box/releases/download/v${version}/sing-box-${version}-linux-${asset_arch}.tar.gz"
curl -fL "$url" -o "$tmpdir/sing-box.tar.gz"
tar -xzf "$tmpdir/sing-box.tar.gz" -C "$tmpdir"

bin="$(find "$tmpdir" -type f -name sing-box | head -n1)"
install -m 0755 "$bin" /usr/local/bin/sing-box

mkdir -p /etc/sing-box /var/log/sing-box
/usr/local/tunnel/core/sing-box/render-sing-box-config

cat > /etc/systemd/system/sing-box.service <<'EOF'
[Unit]
Description=sing-box service
After=network.target nss-lookup.target

[Service]
User=root
ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable sing-box >/dev/null 2>&1
systemctl restart sing-box

print_ok "Sing-box siap"
