#!/usr/bin/env bash
set -Eeuo pipefail

. /usr/local/tunnel/lib/config

load_tunnel_config

ZIVPN_PORT="${ZIVPN_PORT:-5667}"
START="${ZIVPN_UDP_RANGE_START:-6000}"
END="${ZIVPN_UDP_RANGE_END:-19999}"
iface="$(ip -4 route ls | awk '/default/ {for(i=1;i<=NF;i++){if($i=="dev"){print $(i+1); exit}}}' | head -n1)"
[ -n "$iface" ] || iface="eth0"

while iptables -t nat -C PREROUTING -i "$iface" -p udp --dport "$START:$END" -j DNAT --to-destination ":$ZIVPN_PORT" 2>/dev/null; do
  iptables -t nat -D PREROUTING -i "$iface" -p udp --dport "$START:$END" -j DNAT --to-destination ":$ZIVPN_PORT"
done

if command -v iptables-save >/dev/null 2>&1; then
  mkdir -p /etc/iptables
  iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
fi

echo "ZiVPN firewall rule dihapus"
