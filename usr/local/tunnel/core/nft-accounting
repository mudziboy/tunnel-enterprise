#!/usr/bin/env bash
set -Eeuo pipefail
. /usr/local/tunnel/lib/database
TUNNEL_ACCOUNTING_LOG="${TUNNEL_ACCOUNTING_LOG:-/usr/local/tunnel/logs/accounting.log}"
mkdir -p "$(dirname "$TUNNEL_ACCOUNTING_LOG")"
log(){ printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$TUNNEL_ACCOUNTING_LOG"; }
require_nft(){ command -v nft >/dev/null 2>&1 || { echo "nft command not found" >&2; exit 1; }; }
esc(){ db_escape "$1"; }
ensure_base(){
  require_nft
  nft list table inet tunnelgo_accounting >/dev/null 2>&1 || nft add table inet tunnelgo_accounting
  nft list chain inet tunnelgo_accounting uid_out >/dev/null 2>&1 || nft 'add chain inet tunnelgo_accounting uid_out { type filter hook output priority filter; policy accept; }'
}
flush_managed(){
  nft flush chain inet tunnelgo_accounting uid_out >/dev/null 2>&1 || true
}
apply_rules(){
  db_init >/dev/null 2>&1
  ensure_base
  flush_managed
  sqlite3 -separator $'\t' "$TUNNEL_DB" "SELECT username,protocol FROM accounts WHERE status IN ('active','trial') AND protocol IN ('ssh','dropbear') ORDER BY username,protocol;" | while IFS=$'\t' read -r user proto; do
    [ -n "$user" ] || continue
    if id "$user" >/dev/null 2>&1; then
      key="nft:uid:${user}:${proto}:out"
      nft add rule inet tunnelgo_accounting uid_out meta skuid "$user" counter comment "tg:${user}:${proto}:out" >/dev/null 2>&1 || true
      sqlite3 "$TUNNEL_DB" "INSERT OR IGNORE INTO accounting_rules(username,protocol,backend,direction,match_type,match_value,counter_key) VALUES('$(esc "$user")','$(esc "$proto")','nft','out','uid','$(esc "$user")','$(esc "$key")'); UPDATE accounting_rules SET enabled=1,updated_at=CURRENT_TIMESTAMP WHERE counter_key='$(esc "$key")';" 2>/dev/null || true
      log "nft_rule user=$user proto=$proto key=$key"
    fi
  done
}
list_rules(){
  ensure_base
  nft -a list chain inet tunnelgo_accounting uid_out 2>/dev/null || true
}
reset_rules(){
  require_nft
  nft delete table inet tunnelgo_accounting >/dev/null 2>&1 || true
  log "nft_rules_reset"
}
case "${1:-list}" in
  apply) apply_rules ;;
  list|--list) list_rules ;;
  reset) reset_rules ;;
  *) echo "Usage: nft-accounting {apply|list|reset}" >&2; exit 2 ;;
esac
