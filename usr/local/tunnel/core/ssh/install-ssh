#!/usr/bin/env bash
set -Eeuo pipefail
. /usr/local/tunnel/lib/common
. /usr/local/tunnel/lib/config
. /usr/local/tunnel/lib/dependencies
require_root
load_tunnel_config
install_packages openssh-server dropbear
mkdir -p /etc/tunnel/runtime/ssh /etc/tunnel/users/ssh
/usr/local/tunnel/tools/banner-manager >/dev/null 2>&1 || true
[ -f /etc/ssh/sshd_config ] && cp -a /etc/ssh/sshd_config "/etc/tunnel/runtime/ssh/sshd_config.$(date +%Y%m%d-%H%M%S).bak"
set_sshd(){ local key="$1" value="$2"; if grep -Eq "^[#[:space:]]*$key[[:space:]]+" /etc/ssh/sshd_config; then sed -i -E "s|^[#[:space:]]*$key[[:space:]]+.*|$key $value|" /etc/ssh/sshd_config; else echo "$key $value" >> /etc/ssh/sshd_config; fi; }
# SAFE DEFAULT: do not break provider dashboard password login.
set_sshd PasswordAuthentication yes
set_sshd KbdInteractiveAuthentication yes
set_sshd PubkeyAuthentication yes
set_sshd UsePAM yes
set_sshd PermitRootLogin "${TUNNEL_ROOT_LOGIN_POLICY:-yes}"
set_sshd ClientAliveInterval 120
set_sshd ClientAliveCountMax 2
set_sshd Banner /etc/issue.net
passwd -u root >/dev/null 2>&1 || true
usermod -s /bin/bash root >/dev/null 2>&1 || true
cat > /etc/default/dropbear <<EOF
NO_START=0
DROPBEAR_PORT=${DROPBEAR_PORTS%%,*}
DROPBEAR_EXTRA_ARGS="-p ${DROPBEAR_PORTS//,/ -p } -W 65535 -K 120 -I 300 -b /etc/issue.net"
DROPBEAR_BANNER="/etc/issue.net"
EOF
systemctl enable ssh >/dev/null 2>&1 || true
systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
systemctl enable dropbear >/dev/null 2>&1 || true
systemctl restart dropbear 2>/dev/null || true
print_ok "SSH dan Dropbear siap. Root password login tetap diizinkan agar akses VPS tidak terkunci."
