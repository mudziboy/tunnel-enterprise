#!/usr/bin/env bash
set -Eeuo pipefail

service_exists() {
  systemctl list-unit-files "$1.service" >/dev/null 2>&1
}

service_is_active() {
  systemctl is-active --quiet "$1"
}

restart_service() {
  systemctl restart "$1"
}

enable_service() {
  systemctl enable "$1" >/dev/null 2>&1
}

disable_service() {
  systemctl disable "$1" >/dev/null 2>&1 || true
}

service_status_line() {
  local svc="$1"
  if service_is_active "$svc"; then
    printf '%-24s active\n' "$svc"
  else
    printf '%-24s inactive\n' "$svc"
  fi
}

safe_restart_service() {
  local svc="$1"
  if systemctl restart "$svc"; then
    sleep 1
    systemctl is-active --quiet "$svc"
  else
    return 1
  fi
}

show_service_logs() {
  local svc="$1"
  journalctl -u "$svc" -n "${2:-80}" --no-pager
}
