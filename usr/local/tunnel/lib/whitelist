#!/usr/bin/env bash
set -Eeuo pipefail

TUNNEL_CONFIG_DIR="${TUNNEL_CONFIG_DIR:-/etc/tunnel}"
WHITELIST_ENV_FILE="${WHITELIST_ENV_FILE:-$TUNNEL_CONFIG_DIR/whitelist.env}"
WHITELIST_CACHE_FILE="${WHITELIST_CACHE_FILE:-$TUNNEL_CONFIG_DIR/runtime/whitelist-cache.json}"
WHITELIST_RAW_URL="${WHITELIST_RAW_URL:-}"
WHITELIST_CACHE_TTL="${WHITELIST_CACHE_TTL:-21600}"
WHITELIST_FAIL_OPEN="${WHITELIST_FAIL_OPEN:-0}"
GITHUB_TOKEN="${GITHUB_TOKEN:-}"

if [ -f "$WHITELIST_ENV_FILE" ]; then
  set -a
  . "$WHITELIST_ENV_FILE"
  set +a
fi

whitelist_public_ip() {
  curl -4fsS --max-time 8 https://ipv4.icanhazip.com 2>/dev/null | tr -d ' \t\r\n' || true
}

whitelist_cache_valid() {
  [ -f "$WHITELIST_CACHE_FILE" ] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  local now ts ok
  now="$(date +%s)"
  ts="$(jq -r '.checked_at // 0' "$WHITELIST_CACHE_FILE" 2>/dev/null || echo 0)"
  ok="$(jq -r '.success // false' "$WHITELIST_CACHE_FILE" 2>/dev/null || echo false)"
  [ "$ok" = "true" ] || return 1
  [ $((now - ts)) -lt "${WHITELIST_CACHE_TTL:-21600}" ]
}

whitelist_download() {
  local url="$1" output="$2"
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    curl -fsSL --max-time 15 -H "Authorization: token $GITHUB_TOKEN" "$url" -o "$output"
  else
    curl -fsSL --max-time 15 "$url" -o "$output"
  fi
}

profile_allowed() {
  local requested="$1" allowed="$2" r a
  case "$requested" in base) r=1 ;; minimal) r=2 ;; standard) r=3 ;; full|menu) r=4 ;; *) r=0 ;; esac
  case "$allowed" in base) a=1 ;; minimal) a=2 ;; standard) a=3 ;; full|menu) a=4 ;; *) a=0 ;; esac
  [ "$r" -le "$a" ]
}

date_valid() {
  local expiry="$1" today
  today="$(date -u '+%Y-%m-%d')"
  if [[ "$expiry" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    [[ "$expiry" > "$today" || "$expiry" == "$today" ]]
    return
  fi
  if [[ "$expiry" =~ ^[0-9]+$ ]]; then
    [ "$expiry" -gt 0 ]
    return
  fi
  [ "$expiry" = "lifetime" ] || [ "$expiry" = "permanent" ]
}

whitelist_verify() {
  local profile="${1:-standard}"
  local ip url tmp match ip_col status allowed expiry owner note checked_at
  ip="$(whitelist_public_ip)"
  url="${WHITELIST_RAW_URL:-}"

  [ -n "$url" ] || { echo "WHITELIST_RAW_URL belum diset"; return 1; }
  [ -n "$ip" ] || { echo "Gagal mendeteksi IP publik VPS"; return 1; }

  mkdir -p "$(dirname "$WHITELIST_CACHE_FILE")"
  tmp="$(mktemp)"

  if ! whitelist_download "$url" "$tmp"; then
    rm -f "$tmp"
    if whitelist_cache_valid; then
      echo "Whitelist repo tidak tersedia, cache valid dipakai"
      return 0
    fi
    [ "${WHITELIST_FAIL_OPEN:-0}" = "1" ] && { echo "Whitelist repo gagal, fail-open aktif"; return 0; }
    echo "Gagal mengambil file whitelist"
    return 1
  fi

  match="$(grep -E "^[[:space:]]*${ip}[|[:space:]]" "$tmp" | grep -v '^[[:space:]]*#' | tail -n1 || true)"
  rm -f "$tmp"

  [ -n "$match" ] || { echo "IP VPS belum terdaftar: $ip"; return 1; }

  IFS='|' read -r ip_col status allowed expiry owner note extra <<< "$match"
  status="$(echo "${status:-active}" | xargs)"
  allowed="$(echo "${allowed:-standard}" | xargs)"
  expiry="$(echo "${expiry:-lifetime}" | xargs)"
  owner="$(echo "${owner:-Tunnel Go}" | xargs)"
  note="$(echo "${note:-}" | xargs)"

  [ "$status" = "active" ] || { echo "IP VPS tidak aktif: $status"; return 1; }
  profile_allowed "$profile" "$allowed" || { echo "Profile tidak diizinkan. Request=$profile Allowed=$allowed"; return 1; }
  date_valid "$expiry" || { echo "Whitelist expired: $expiry"; return 1; }

  checked_at="$(date +%s)"
  cat > "$WHITELIST_CACHE_FILE" <<EOF
{
  "success": true,
  "server_ip": "$ip",
  "status": "$status",
  "allowed_profile": "$allowed",
  "expiry": "$expiry",
  "owner": "$owner",
  "note": "$note",
  "checked_at": $checked_at
}
EOF
  chmod 600 "$WHITELIST_CACHE_FILE"
  echo "IP whitelist valid: $ip"
}

whitelist_require() {
  local profile="${1:-standard}"
  if whitelist_verify "$profile" >/tmp/tunnel-whitelist-check.log 2>&1; then
    return 0
  fi
  cat /tmp/tunnel-whitelist-check.log >&2
  exit 90
}
