#!/usr/bin/env bash
set -Eeuo pipefail

TUNNEL_ROOT="${TUNNEL_ROOT:-/usr/local/tunnel}"
TUNNEL_CONFIG_DIR="${TUNNEL_CONFIG_DIR:-/etc/tunnel}"
TUNNEL_LOG_DIR="${TUNNEL_LOG_DIR:-/usr/local/tunnel/logs}"

red='\033[0;31m'
green='\033[0;32m'
yellow='\033[1;33m'
blue='\033[0;34m'
cyan='\033[0;36m'
bold='\033[1m'
nc='\033[0m'

print_ok() { printf "%b\n" "${green}[OK]${nc} $*"; }
print_info() { printf "%b\n" "${cyan}[INFO]${nc} $*"; }
print_warn() { printf "%b\n" "${yellow}[WARN]${nc} $*"; }
print_err() { printf "%b\n" "${red}[ERR]${nc} $*" >&2; }
print_title() { printf "%b\n" "${bold}${cyan}$*${nc}"; }

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    print_err "Jalankan sebagai root"
    exit 1
  fi
}

ensure_dir() {
  mkdir -p "$1"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

pause() {
  read -rp "Enter untuk kembali..." _
}

confirm() {
  local msg="${1:-Lanjutkan?}"
  local ans
  read -rp "$msg [y/N]: " ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

safe_source() {
  local file="$1"
  if [ -f "$file" ]; then
    set -a
    . "$file"
    set +a
  fi
}

run_cmd() {
  "$@"
}

ensure_parent() {
  mkdir -p "$(dirname "$1")"
}

write_file_atomic() {
  local target="$1"
  local tmp
  tmp="$(mktemp)"
  cat > "$tmp"
  ensure_parent "$target"
  install -m "${2:-0644}" "$tmp" "$target"
  rm -f "$tmp"
}

timestamp() {
  date '+%Y%m%d-%H%M%S'
}

human_date() {
  date '+%Y-%m-%d %H:%M:%S'
}
